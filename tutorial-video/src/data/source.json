        "        return \"build_web_query\" if state[\"route\"] == \"hybrid\" else \"generate\"",
        "    if state[\"retry_count\"] >= Config.MAX_QUERY_RETRIES:",
        "        return \"fallback_generate\"",
        "    return \"rewrite_query\""
      ]
